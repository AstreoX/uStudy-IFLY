# 数据库配置
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ustudy

# 应用配置
APP_ENV=development
DEBUG=true

# Uvicorn 运行参数（4核8G 推荐）
UVICORN_WORKERS=6
UVICORN_LIMIT_CONCURRENCY=600
UVICORN_BACKLOG=2048
UVICORN_TIMEOUT_KEEP_ALIVE=75

# 数据库连接池（每个 worker）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=1800

# 安全配置（后续步骤使用）
SECRET_KEY=your-secret-key-here

# JWT 配置
JWT_SECRET_KEY=jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Apple Sign-In（可选）
APPLE_CLIENT_ID=
APPLE_TEAM_ID=

# 邮件配置
EMAIL_PROVIDER=resend
RESEND_API_KEY=
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@ustudy.app
SMTP_FROM_NAME=uStudy
SMTP_USE_TLS=true

# 验证码配置
VERIFICATION_CODE_EXPIRE_MINUTES=10
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_RATE_LIMIT_SECONDS=60
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_TOKEN_EXPIRE_MINUTES=5

# OpenRouter / LLM 配置
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen3.5-397b-a17b

# RAG 配置（可选，有默认值）
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIMENSION=1536
# EMBEDDING_BATCH_SIZE=20
# CHUNK_SIZE_TOKENS=600
# CHUNK_OVERLAP_TOKENS=100
# CHUNK_MIN_SIZE_TOKENS=50
# RETRIEVAL_TOP_K=10
# RERANK_TOP_K=5
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# 附件文本提取配置（可选，有默认值）
# ATTACHMENT_TEXT_MAX_TOKENS=10000
# ATTACHMENT_TEXT_TIMEOUT_SECONDS=30
# ATTACHMENT_CACHE_EXTRACTED_TEXT=true
