# 数据库配置
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ustudy_dev

# 应用配置
APP_ENV=experiment
DEBUG=false
PUBLIC_API_BASE_URL=https://ustudy.top
PUBLIC_WEB_BASE_URL=https://ustudy.top
PUBLIC_APP_BASE_URL=https://ustudy.top
DOWNLOAD_BASE_URL=https://ustudy.top
SUPPORT_CONTACT_EMAIL=contact@ustudy.top
PUBLIC_REGISTRATION_ENABLED=true
AUTH_EMAIL_ENABLED=true
APPLE_LOGIN_ENABLED=false
SPACE_CREATION_ENABLED=false
CORS_DEV_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:8080,http://localhost:9000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:3000,http://127.0.0.1:8080,http://127.0.0.1:9000
CORS_PROD_ORIGINS=https://ustudy.top,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# Uvicorn 运行参数（4核8G 推荐）
UVICORN_WORKERS=6
UVICORN_LIMIT_CONCURRENCY=600
UVICORN_BACKLOG=2048
UVICORN_TIMEOUT_KEEP_ALIVE=75

# 数据库连接池（每个 worker）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=1800

# 独立 OJ（本地默认关闭；禁止回退到 backend 容器内执行代码）
OJ_ENABLED=false
OJ_MANAGER_URL=http://oj-manager:8091
# 默认留空，Compose 的 oj-secret-init 会持久生成；也可由外部 secret manager 覆盖。
OJ_MANAGER_TOKEN=
OJ_EXECUTOR_TOKEN=
OJ_EXECUTOR_VERSION=v1.12.2
OJ_EXECUTOR_COMMIT=955585f050286993ead2b2dd11c107d529b6b508
OJ_PARALLELISM=2
OJ_QUEUE_LIMIT=50
OJ_SAMPLE_RATE_PER_MINUTE=10
OJ_SOURCE_MAX_BYTES=65536
OJ_SAMPLE_RETENTION_HOURS=24
OJ_REQUEST_TIMEOUT_SECONDS=15
OJ_RUN_POLL_SECONDS=0.5
OJ_RUN_TIMEOUT_SECONDS=90

# 安全配置（后续步骤使用）
SECRET_KEY=your-secret-key-here

# JWT 配置
JWT_SECRET_KEY=jwt-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Apple Sign-In（可选）
APPLE_CLIENT_ID=
APPLE_TEAM_ID=

# 邮件配置
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=uStudy
SMTP_USE_TLS=true
INACTIVITY_CARE_EMAIL_ENABLED=false

# 验证码配置
VERIFICATION_CODE_EXPIRE_MINUTES=10
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_RATE_LIMIT_SECONDS=60
VERIFICATION_CODE_MAX_ATTEMPTS=5
VERIFICATION_TOKEN_EXPIRE_MINUTES=5

# DashScope / LLM 配置
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_MODEL=qwen3.6-plus
GEMINI_MODEL=qwen3.6-plus
QUIZ_EVALUATION_MODEL=qwen3.6-plus
MASTERY_EVALUATION_MODEL=qwen3.6-plus
LLM_TIMEOUT_SECONDS=60
LLM_STREAM_CONNECT_TIMEOUT_SECONDS=10
LLM_STREAM_READ_TIMEOUT_SECONDS=180
LLM_STREAM_WRITE_TIMEOUT_SECONDS=30
LLM_STREAM_POOL_TIMEOUT_SECONDS=30
LLM_TOOL_RESULT_MAX_CHARS=20000
LLM_CONTEXT_MAX_CHARS=120000
ARTIFACT_MODEL=qwen3.6-plus
ARTIFACT_TIMEOUT_SECONDS=300

# 图片生成（GPT Image 2，OpenAI Images API 兼容中转）
IMAGE_GENERATION_BASE_URL=https://openapi.center
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_GENERATION_TIMEOUT_SECONDS=90
IMAGE_GENERATION_SIZE=1024x1024
IMAGE_GENERATION_QUALITY=low
IMAGE_GENERATION_OUTPUT_FORMAT=png
USE_BASE64_FOR_IMAGES=true

# RAG 配置（可选，有默认值）
# RAG_BACKEND=hybrid
# RAG_ENABLE_RERANK=false
# RAG_AUTO_INJECT_ENABLED=true
LEARNING_PATH_AUTO_EXPAND_ENABLED=true
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIMENSION=1024
# EMBEDDING_BATCH_SIZE=20
# CHUNK_SIZE_TOKENS=600
# CHUNK_OVERLAP_TOKENS=100
# CHUNK_MIN_SIZE_TOKENS=50
# RETRIEVAL_TOP_K=10
# RERANK_TOP_K=5
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# 附件文本提取配置（可选，有默认值）
# ATTACHMENT_TEXT_MAX_TOKENS=10000
# ATTACHMENT_TEXT_TIMEOUT_SECONDS=30
# ATTACHMENT_CACHE_EXTRACTED_TEXT=true
