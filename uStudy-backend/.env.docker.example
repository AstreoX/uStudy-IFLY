# Docker 部署环境变量
# 复制此文件为 .env 后修改

# 数据库密码
DB_PASSWORD=your-secure-password-here

# 应用配置
APP_ENV=experiment
DEBUG=false
PUBLIC_API_BASE_URL=https://ustudy.top
PUBLIC_WEB_BASE_URL=https://ustudy.top
PUBLIC_APP_BASE_URL=https://ustudy.top
DOWNLOAD_BASE_URL=https://ustudy.top
SUPPORT_CONTACT_EMAIL=contact@ustudy.top
PUBLIC_REGISTRATION_ENABLED=true
AUTH_EMAIL_ENABLED=true
APPLE_LOGIN_ENABLED=false
SPACE_CREATION_ENABLED=false
CORS_DEV_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://localhost:8080,http://localhost:9000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:3000,http://127.0.0.1:8080,http://127.0.0.1:9000
CORS_PROD_ORIGINS=https://ustudy.top,http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://localhost:8080,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175

# Uvicorn 运行参数（4核8G 推荐）
UVICORN_WORKERS=6
UVICORN_LIMIT_CONCURRENCY=600
UVICORN_BACKLOG=2048
UVICORN_TIMEOUT_KEEP_ALIVE=75

# 数据库连接池（每个 worker）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=15
DB_POOL_RECYCLE_SECONDS=1800

# 独立 OJ（默认关闭；仅在 HK 主机安全预检通过后启用）
OJ_ENABLED=false
OJ_MANAGER_URL=http://oj-manager:8091
# 默认留空：oj-secret-init 会在两个命名 Docker volume 中各生成一枚
# 64 字符随机令牌。仅在外部 secret manager 托管时覆盖这两个值。
OJ_MANAGER_TOKEN=
OJ_EXECUTOR_TOKEN=
OJ_EXECUTOR_VERSION=v1.12.2
OJ_EXECUTOR_COMMIT=955585f050286993ead2b2dd11c107d529b6b508
OJ_PARALLELISM=2
OJ_QUEUE_LIMIT=50
OJ_SAMPLE_RATE_PER_MINUTE=10
OJ_SOURCE_MAX_BYTES=65536
OJ_SAMPLE_RETENTION_HOURS=24
OJ_REQUEST_TIMEOUT_SECONDS=15
OJ_RUN_POLL_SECONDS=0.5
OJ_RUN_TIMEOUT_SECONDS=90

# 安全密钥（使用 openssl rand -base64 32 生成）
SECRET_KEY=your-secret-key-here
JWT_SECRET_KEY=your-jwt-secret-key-here

# DashScope / LLM 配置（必需）
DASHSCOPE_API_KEY=your-dashscope-api-key
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Main chat default; background task models are configured separately below.
LLM_DEFAULT_MODEL=deepseek/deepseek-v4.1-flash
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
BACKGROUND_LLM_MODEL=deepseek/deepseek-v4.1-flash
GEMINI_MODEL=deepseek/deepseek-v4.1-flash
QUIZ_REASONING_MODEL=deepseek/deepseek-v4.1-flash
MEMORY_EXTRACTION_MODEL=deepseek/deepseek-v4.1-flash
KNOWLEDGE_GRAPH_MODEL=deepseek/deepseek-v4.1-flash
QUIZ_EVALUATION_MODEL=deepseek/deepseek-v4.1-flash
MASTERY_EVALUATION_MODEL=deepseek/deepseek-v4.1-flash
LEARNING_PATH_EXPAND_MODEL=deepseek/deepseek-v4.1-flash
SUGGESTION_MODEL=deepseek/deepseek-v4.1-flash
TITLE_GENERATION_MODEL=deepseek/deepseek-v4.1-flash
# PPT jobs use their own model; the main chat selector does not change this.
PRESENTATION_LLM_MODEL=deepseek/deepseek-v4.1-flash
ARTIFACT_MODEL=deepseek/deepseek-v4.1-flash
ARTIFACT_TIMEOUT_SECONDS=300

# 图片生成（GPT Image 2，OpenAI Images API 兼容中转）
IMAGE_GENERATION_BASE_URL=https://openapi.center
IMAGE_GENERATION_API_KEY=
IMAGE_GENERATION_MODEL=gpt-image-2
IMAGE_GENERATION_TIMEOUT_SECONDS=90
IMAGE_GENERATION_SIZE=1024x1024
IMAGE_GENERATION_QUALITY=low
IMAGE_GENERATION_OUTPUT_FORMAT=png
USE_BASE64_FOR_IMAGES=true

# RAG 配置
RAG_BACKEND=hybrid
RAG_ENABLE_RERANK=false
RAG_AUTO_INJECT_ENABLED=true
LEARNING_PATH_AUTO_EXPAND_ENABLED=true

# 邮件配置（实验环境关闭）
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=uStudy
INACTIVITY_CARE_EMAIL_ENABLED=false

VLM_MODEL=deepseek/deepseek-v4.1-flash
